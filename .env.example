# --- Infrastructure ---
DATABASE_URL=postgres://inbox:inbox@localhost:5432/inbox_agent
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
LOG_LEVEL=info
# Comma-separated operator API keys (dashboard / internal tools). Generate with: openssl rand -hex 32
API_KEYS=change-me-operator-key
# Shared secret used to sign inbound webhooks (HMAC-SHA256). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-webhook-secret
# Browser origins allowed to call the API (the dashboard).
CORS_ORIGINS=http://localhost:5173
# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=120

# --- Agent ---
# "anthropic" uses the Claude API; "scripted" runs a deterministic offline model (demos, CI).
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
