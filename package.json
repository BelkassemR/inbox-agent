{
  "name": "inbox-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx packages/core/src/db/migrate-cli.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:dashboard": "pnpm --filter @inbox/dashboard dev",
    "loadtest": "tsx loadtest/intake.ts",
    "mcp": "pnpm --silent --filter @inbox/mcp-server start"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.15.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@inbox/core": "workspace:*",
    "@inbox/mcp-server": "workspace:*"
  }
}
